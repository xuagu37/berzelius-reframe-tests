# Copy this file to .pilot.env and fill in the Slurm project account.
# The pilot helper loads .pilot.env automatically.

RFM_ACCOUNT=

# Usually unnecessary: the helper searches the active environment and the
# standard project-local Conda environment automatically.
# RFM_BIN=/absolute/path/to/reframe-hpc/bin/reframe

# Change this only if Berzelius provides a different CUDA build module.
RFM_CUDA_MODULE=buildenv-gcccuda/12.1.1-gcc12.3.0

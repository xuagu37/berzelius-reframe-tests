# Copy this file to berzelius.env and fill in the Slurm project account.
# The berzelius-tests runner loads berzelius.env automatically.

RFM_ACCOUNT=nsc

# Named Mamba environment containing ReFrame. Leave empty to use ReFrame from
# the currently active shell environment.
RFM_ENV=reframe-hpc

# Leave empty to use CUDA from the system/default environment. Set a module
# name here only when the test should load a specific CUDA build environment.
RFM_CUDA_MODULE=
